# FICTIONAL model module, invented only to show the overlay shape. It stands in
# for the modules a real private overlay holds: keys and lists that exist only
# in the overlay's formats, declared here and never in the public library.
# It is marked `controlled` to show the mechanics; nothing in it is real.
module        xtdl
version       0.6.0
distribution  controlled
source        "invented for this example; no external document"
key   sector       int     -    "fictional: which of 32 sectors the reporter is in"
key   status       string  -    "fictional: state of the reporter: idle, active, fault or unknown"
key   day_s        float   s    "fictional: time of the report, seconds since the last UTC midnight"
list  contacts                  "fictional: the things the reporter has in view"
key   contact_id   int     -    "fictional: number of one contact, 0 to 255 (a key of an item of contacts)"
key   bearing_deg  float   deg  "fictional: direction of one contact from the reporter, degrees (a key of an item of contacts)"
key   range_m      float   m    "fictional: distance of one contact from the reporter (a key of an item of contacts)"
# The binary formats hold a time of day and no date. A format that holds the
# full instant in the public key `time_ms` fills `xtdl.day_s` through this line.
derive  xtdl.day_s  day_seconds  time_ms
key   position_sent  int  -  "fictional: 1 when the report carries a position (xtdl-flag-example)"
# engine-spec 0.12: `present` sets the flag to 1 whenever the entity holds a latitude.
derive  xtdl.position_sent  present  lat
key   lane_offset_m  int     m    "fictional: signed distance of the reporter from the middle of its lane, whole meters (xtdl-values-example)"
# engine-spec 0.16, for xtdl-frame-example: an instant as whole seconds and
# nanoseconds, a position in earth-centered, earth-fixed meters, and a geoid
# separation. Each derive line fills its target only when the target is absent.
key   t_s       int    s  "fictional: whole seconds since 1970-01-01T00:00:00Z (xtdl-frame-example)"
key   t_ns      int    ns "fictional: nanoseconds past t_s (xtdl-frame-example)"
key   ecef_x_m  float  m  "fictional: earth-centered, earth-fixed X, WGS 84 (xtdl-frame-example)"
key   ecef_y_m  float  m  "fictional: earth-centered, earth-fixed Y, WGS 84 (xtdl-frame-example)"
key   ecef_z_m  float  m  "fictional: earth-centered, earth-fixed Z, WGS 84 (xtdl-frame-example)"
key   geoid_m   float  m  "fictional: height of the geoid above the ellipsoid at the position (xtdl-frame-example)"
key   h_msl_m   float  m  "fictional: height above mean sea level (derived; xtdl-frame-example)"
derive  time_ms        ms_of        xtdl.t_s xtdl.t_ns
derive  xtdl.t_s       sec_of       time_ms
derive  xtdl.t_ns      nsec_of      time_ms
derive  lat            lat_of_ecef  xtdl.ecef_x_m xtdl.ecef_y_m xtdl.ecef_z_m
derive  lon            lon_of_ecef  xtdl.ecef_x_m xtdl.ecef_y_m xtdl.ecef_z_m
derive  hae            hae_of_ecef  xtdl.ecef_x_m xtdl.ecef_y_m xtdl.ecef_z_m
derive  xtdl.ecef_x_m  ecef_x       lat lon hae
derive  xtdl.ecef_y_m  ecef_y       lat lon hae
derive  xtdl.ecef_z_m  ecef_z       lat lon hae
derive  xtdl.h_msl_m   sub          hae xtdl.geoid_m
# engine-spec 0.18, for xtdl-report-example: a class with a confidence, and a
# text of flag tokens built from other keys and read back.
key   class        string  -  "fictional: what the reporter classifies the contact as (xtdl-report-example)"
key   confidence   float   -  "fictional: confidence in the class, 0 to 1; written only with a class (xtdl-report-example)"
key   flags        string  -  "fictional: flag tokens separated by spaces: positioned, sectored, degraded (xtdl-report-example)"
key   degraded     int     -  "fictional: 1 when the flags hold the token degraded (xtdl-report-example)"
derive  xtdl.flags     tokens:space:positioned,sectored  xtdl.position_sent xtdl.sector
derive  xtdl.degraded  has_token:space:degraded          xtdl.flags
