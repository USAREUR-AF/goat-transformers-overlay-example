# xtdl-switch-example: a FICTIONAL format, invented only for this example: a
# sequential `bits` report whose second part is laid out by a value read in its
# first part (engine-spec 0.20 `switch`). Layout: pack.md.
format        xtdl-switch-example
version       0.1.0
distribution  controlled
source        "invented for this example; no external document"
uses          xtdl
wire          bits
layout        sequential
bit_order     msb

field  xtdl.sector       5  uint
field  xtdl.report_type  3  uint
switch xtdl.report_type
  case 1
    field  lat  32  sscale:1/10000000
    field  lon  32  sscale:1/10000000
  case 2
    field  speed_ms  16  uscale:1/10
  case 3,4
    field  xtdl.lane_offset_m  8  smag
  else
end
